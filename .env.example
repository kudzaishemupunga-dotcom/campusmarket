# Local development only. Ignored by production builds and production servers.
# Do not put real student data into demo mode.
CAMPUSMARKET_DEMO=true

# Set CAMPUSMARKET_DEMO=false to use your own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required for validated image uploads; never prefix NEXT_PUBLIC_.
# Obtain from your own Supabase project's API settings. Do not commit this value.
SUPABASE_SERVICE_ROLE_KEY=

# Exact canonical app origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional live integration tests only. Use dedicated fictional test accounts.
# SUPABASE_TEST_STUDENT_A_EMAIL=
# SUPABASE_TEST_STUDENT_A_PASSWORD=
# SUPABASE_TEST_STUDENT_B_EMAIL=
# SUPABASE_TEST_STUDENT_B_PASSWORD=
# SUPABASE_TEST_PENDING_EMAIL=
# SUPABASE_TEST_PENDING_PASSWORD=
