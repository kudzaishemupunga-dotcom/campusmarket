# CampusMarket 2.0 — Wise Owl High School Westgate Student Project Marketplace
# Configure your own dedicated Supabase project credentials below.
# Never commit .env.local or real credentials to version control.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret required for validated private product image uploads.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Exact canonical origin (no trailing slash). Must use https:// in production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional exact browser origins, DEVELOPMENT ONLY, comma-separated. No wildcards.
# For phone testing set NEXT_PUBLIC_SITE_URL to the PC LAN origin too, then
# allow that exact /auth/callback URL in your development Supabase project.
# CAMPUSMARKET_DEV_ORIGINS=http://192.168.1.20:3000
CAMPUSMARKET_DEV_ORIGINS=
